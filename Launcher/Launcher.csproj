<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- WinExe = no separate console window when the launcher opens. The windowed path pipes
         the backend's Console output into an in-window log panel; the console verbs
         (play/check/demo/...) reattach to the parent terminal via AttachConsole in Main. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>ptolaunch</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- WinForms hosts the native launcher window (no-arg / `gui`). Console verbs
         (play/check/demo/...) still work; only the window path opens a window. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- x64 so it shares one .NET 10 runtime with the server. Uses steam_api64.dll
         (Steamworks.NET win-x64). The game is a separate 32-bit process with its own
         steam_api.dll, so the launcher's arch is independent of it. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Steamworks.NET" Version="2024.8.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- steam_api64.dll must sit beside the exe; steam_appid.txt=480 lets Init run
         without launching via Steam. Use the MODERN 64-bit dll that matches
         Steamworks.NET 2024.8.0 (has SteamNetworkingSockets012 for the relay): the
         Windows-x64 steam_api64.dll from Steamworks.NET-Standalone_2024.8.0.zip
         (github.com/rlabrecque/Steamworks.NET releases) or Steamworks SDK 1.60. Do
         NOT use the game's Clients/ dll - that one is ~2018 and has no networking API.
         Git-ignored like the other native bins; guarded so a clone without it still
         builds (Steam path just won't run until it's present). -->
    <None Include="steam_api64.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('steam_api64.dll')" />
    <None Include="steam_appid.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
