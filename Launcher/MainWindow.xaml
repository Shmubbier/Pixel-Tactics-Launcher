<Window x:Class="PtoLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pixel Tactics Online"
        Icon="/assets/pto_icon.png"
        Height="420" Width="480"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#14121C">
    <!-- Edit this file in Visual Studio's / Blend's visual designer. The code-behind
         (MainWindow.xaml.cs) wires the named controls; keep the x:Name values if you
         restyle, and the event handler names (OnPlay/OnGear/OnToggleLog) if you rewire.
         Sprites live in assets/ (WPF Resource); pixel art uses NearestNeighbor scaling. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top bar: settings gear (spr_ingame_settings_0, 32x32 native) -->
        <Button x:Name="GearButton" Grid.Row="0" Click="OnGear" ToolTip="Toggle Online / Offline"
                Width="32" Height="32" Margin="0,12,12,0"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Background="Transparent" BorderThickness="0" Cursor="Hand">
            <Image Source="/assets/spr_ingame_settings_0.png" Width="32" Height="32"
                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>
        </Button>

        <!-- Center: logo, PLAY, status -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- Logo (spr_logo_0, 384x144 native). Keep the 384:144 (8:3) ratio to avoid distortion. -->
            <Image Source="/assets/spr_logo_0.png" Width="360" Height="135"
                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                   HorizontalAlignment="Center" Margin="0,0,0,28"/>

            <!-- PLAY button: spr_ready_button_1 (up), swaps to spr_ready_button_0 while pressed.
                 80x32 sprite drawn at 160x64 (exact 2x -> crisp). Use multiples of 80x32 to stay sharp. -->
            <Button x:Name="PlayButton" Click="OnPlay"
                    Width="160" Height="64" Margin="0,0,0,6"
                    HorizontalAlignment="Center"
                    Background="Transparent" BorderThickness="0" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="root" Background="Transparent">
                            <Image x:Name="imgUp" Source="/assets/spr_ready_button_1.png"
                                   Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            <Image x:Name="imgDown" Source="/assets/spr_ready_button_0.png"
                                   Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"
                                   Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="imgUp" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="imgDown" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="root" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <TextBlock x:Name="StatusText" Text=""
                       FontSize="12" Foreground="#DCDCDC"
                       HorizontalAlignment="Center" Margin="0,16,0,0"/>
        </StackPanel>

        <!-- Log toggle -->
        <Button x:Name="LogToggle" Grid.Row="2" Content="&#x25BE; Show log"
                Click="OnToggleLog"
                HorizontalAlignment="Left" Margin="12,0,0,8"
                Padding="8,3" FontSize="11"
                Foreground="#DCDCDC" Background="#242230"
                BorderThickness="0" Cursor="Hand"/>

        <!-- Collapsible log panel (fed by the backend's console output) -->
        <TextBox x:Name="LogBox" Grid.Row="3" Visibility="Collapsed"
                 Height="200" Margin="12,0,12,12"
                 IsReadOnly="True" IsTabStop="False"
                 VerticalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap"
                 FontFamily="Consolas" FontSize="11"
                 Background="#0D0C14" Foreground="#BAD0A0"
                 BorderThickness="1" BorderBrush="#2A2838"/>
    </Grid>
</Window>
