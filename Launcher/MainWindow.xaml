<Window x:Class="PtoLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pixel Tactics Online"
        Height="320" Width="480"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#14121C">
    <!-- Edit this file in Visual Studio's / Blend's visual designer. The code-behind
         (MainWindow.xaml.cs) wires the named controls; keep the x:Name values if you
         restyle, and the event handler names (OnPlay/OnGear/OnToggleLog) if you rewire. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top bar: settings gear -->
        <Button x:Name="GearButton" Grid.Row="0" Content="&#x2699;"
                Click="OnGear" ToolTip="Toggle Online / Offline"
                Width="34" Height="34" Margin="0,10,10,0"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                FontSize="15" Foreground="#DCDCDC" Background="#242230"
                BorderThickness="0" Cursor="Hand"/>

        <!-- Center: title, PLAY, status -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="PIXEL TACTICS ONLINE"
                       FontSize="22" FontWeight="Bold" Foreground="#F2B134"
                       HorizontalAlignment="Center" Margin="0,0,0,22"/>
            <Button x:Name="PlayButton" Content="PLAY" Click="OnPlay"
                    Width="220" Height="60" FontSize="18" FontWeight="Bold"
                    Foreground="#111111" Background="#F2B134"
                    BorderThickness="0" Cursor="Hand"/>
            <TextBlock x:Name="StatusText" Text=""
                       FontSize="12" Foreground="#DCDCDC"
                       HorizontalAlignment="Center" Margin="0,16,0,0"/>
        </StackPanel>

        <!-- Log toggle -->
        <Button x:Name="LogToggle" Grid.Row="2" Content="&#x25BE; Show log"
                Click="OnToggleLog"
                HorizontalAlignment="Left" Margin="12,0,0,8"
                Padding="8,3" FontSize="11"
                Foreground="#DCDCDC" Background="#242230"
                BorderThickness="0" Cursor="Hand"/>

        <!-- Collapsible log panel (fed by the backend's console output) -->
        <TextBox x:Name="LogBox" Grid.Row="3" Visibility="Collapsed"
                 Height="200" Margin="12,0,12,12"
                 IsReadOnly="True" IsTabStop="False"
                 VerticalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap"
                 FontFamily="Consolas" FontSize="11"
                 Background="#0D0C14" Foreground="#BAD0A0"
                 BorderThickness="1" BorderBrush="#2A2838"/>
    </Grid>
</Window>
